# Required when OpenAlex is enabled. Free key: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Required when ScienceDirect is enabled.
ELSEVIER_API_KEY=

# Optional institutional token supplied by Elsevier API Support.
ELSEVIER_INST_TOKEN=

# Public academic APIs use direct HTTPS by default. Set true only for a verified proxy.
LITERATURE_USE_SYSTEM_PROXY=false

# Optional Semantic Scholar API key. Leave blank to disable that source.
SEMANTIC_SCHOLAR_API_KEY=

# Web of Science Starter API. The legacy typo WEBOFSCIENDE_API_KEY is also accepted.
WEBOFSCIENCE_API_KEY=

# Optional delivery credentials. The default configuration only writes locally.
FEISHU_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
